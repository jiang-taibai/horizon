    "image_api_key_env": "DASHSCOPE_API_KEY",
    "image_size": "1024*1024",
    "prompt_language": "zh",
    "output_dir": "data/images",
    "image_retention_days": 30,
    "public_base_url": "",
    "timeout_sec": 90.0
  },
  "publisher": {
    "enabled": false,
    "api_url": "${HORIZON_BLOG_API_URL}",
    "token_env": "HORIZON_BLOG_TOKEN",
    "languages": ["zh"],
    "slug_prefix": "",
    "timeout_sec": 30.0
  }
