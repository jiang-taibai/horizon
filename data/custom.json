{
  "sources": [
    {
      "name": "示例 JSON 源",
      "type": "example_json",
      "enabled": false,
      "category": "tech",
      "profile": null,
      "options": {
        "url": "https://api.example.com/items",
        "title_field": "title",
        "url_field": "link",
        "id_field": "id",
        "time_field": "published_at"
      }
    }
  ],
  "illustrator": {
    "enabled": true,
    "illustrate_top_n": 1,
